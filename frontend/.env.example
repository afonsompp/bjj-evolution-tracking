# Copy to .env.local and fill in. Only VITE_-prefixed vars reach the app.
# In production (Render Static Site) set these in the service's Environment.

# Backend base URL. Leave EMPTY in dev to use the Vite dev proxy (see vite.config.ts).
# In production set it to the backend URL, e.g. https://your-backend.onrender.com
VITE_API_BASE_URL=

# Dev only: where `npm run dev` proxies /api (default http://localhost:8080).
# Set your machine's LAN IP to test from another device, e.g. http://10.0.0.193:8080
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
