# Copy to .env.local and fill in. Only VITE_-prefixed vars reach the app.
# In production (Render Static Site) set these in the service's Environment.

# Backend base URL. Leave EMPTY in dev to use the Vite dev proxy (see vite.config.ts).
# In production set it to the backend URL, e.g. https://your-backend.onrender.com
VITE_API_BASE_URL=

# Dev only: where `npm run dev` proxies /api (default http://localhost:8080).
# Set your machine's LAN IP to test from another device, e.g. http://10.0.0.193:8080
VITE_DEV_PROXY_TARGET=http://localhost:8080

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Observability — Sentry (frontend). Leave VITE_SENTRY_DSN empty to disable
# (the SDK becomes a no-op). DSN comes from the Sentry project (Settings → Client
# Keys). These VITE_ vars are read at build time and shipped to the browser.
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=production
VITE_SENTRY_TRACES_SAMPLE_RATE=0.05
# Optional: tie errors to a deploy. Render exposes the commit as RENDER_GIT_COMMIT.
VITE_SENTRY_RELEASE=

# Source-map upload (build-time only, NOT shipped to the browser — no VITE_ prefix).
# Set all three in the Render build environment to get de-minified stack traces.
# Without SENTRY_AUTH_TOKEN the Vite plugin is skipped entirely.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
