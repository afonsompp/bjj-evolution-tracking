<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging setup. The Sentry appender is NOT declared here: the Spring Boot
  integration attaches it to the root logger at runtime (configured via the
  `sentry.logging.*` properties), so declaring it here would double-report.

  Profiles:
    local  -> human-readable colored console (matches the old pattern).
    !local -> single-line JSON to stdout (Render captures stdout) so logs are
              queryable. traceId comes from RequestCorrelationFilter's MDC.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <springProfile name="local">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %highlight(%-5level) [%X{traceId:-no-trace}] [%15.15t] %-40.40logger{39} - %msg%n</pattern>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="!local">
        <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="net.logstash.logback.encoder.LogstashEncoder">
                <includeMdcKeyName>traceId</includeMdcKeyName>
                <customFields>{"app":"tracking"}</customFields>
            </encoder>
        </appender>
        <root level="INFO">
            <appender-ref ref="JSON"/>
        </root>
    </springProfile>
</configuration>
