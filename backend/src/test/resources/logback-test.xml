<?xml version="1.0" encoding="UTF-8"?>
<!--
  Test-only logging. Takes precedence over logback-spring.xml on the test
  classpath, so the suite logs a readable console line instead of the production
  JSON (which is noisy to read in test output). traceId comes from TraceIdFilter.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level [%X{traceId:-no-trace}] %-40.40logger{39} - %msg%n</pattern>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
